# ==============================================================================
# AfriSolve AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Server Network Configuration
PORT=5173
HOST=127.0.0.1

# Application Environment (development | production)
# In production, DEMO_MODE must be false, and SESSION_SECRET must be >= 32 characters.
NODE_ENV=development
DEMO_MODE=true

# Persistent Database Directory (defaults to ./data/postgres)
DATA_DIR=./data/postgres

# Session Secret (Required in production, minimum 32 random characters)
# SESSION_SECRET=replace_with_a_secure_random_32_character_string_here

# AI Provider Configuration (Optional: Ollama integration)
# When unset or unreachable, AfriSolve AI uses its local heuristic fallback.
# AI_BASE_URL=http://127.0.0.1:11434/api
# AI_MODEL=llama3.2
# OLLAMA_API_KEY=

# Production Email Delivery (Optional: real SMTP server)
# When unset, AfriSolve AI logs outbound verification emails to the demo mailbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="AfriSolve AI <notifications@example.com>"
